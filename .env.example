# ==========================
# MAIN MODEL
# ==========================
# embedded_gguf = no LM Studio, Ollama or remote API needed.
# openai_compatible = connect to a /v1 server.
MODEL_BACKEND=embedded_gguf
AI_TEMPERATURE=0.35
AI_TIMEOUT_SECONDS=300

# Embedded GGUF / llama.cpp
LOCAL_MODEL_PATH=models/model.gguf
LOCAL_MODEL_NAME=local-gguf
LOCAL_MODEL_CONTEXT=8192
# 0 = CPU. With a GPU-enabled llama-cpp build, raise this or use -1 to try all layers.
LOCAL_MODEL_GPU_LAYERS=0
# 0 = let llama.cpp choose a suitable CPU thread count.
LOCAL_MODEL_THREADS=0
# Usually blank: llama.cpp reads the chat template from modern GGUF metadata.
LOCAL_MODEL_CHAT_FORMAT=
LOCAL_MODEL_VERBOSE=false
# Optional llama.cpp-compatible LoRA adapter (after conversion to GGUF)
LOCAL_LORA_PATH=
LOCAL_LORA_SCALE=1.0

# Only used when MODEL_BACKEND=openai_compatible
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_API_KEY=local-key
AI_MODEL=local-model

APP_HOST=0.0.0.0
APP_PORT=8000
API_TOKEN=
DATABASE_PATH=data/agent.db
UPLOADS_DIR=data/uploads
AUTO_MEMORY=true
ENABLE_TOOLS=true
ENABLE_PLUGINS=true

MAX_CONTEXT_MESSAGES=20
MEMORY_RESULTS=8
RAG_RESULTS=6
MAX_UPLOAD_MB=20
SQLITE_BUSY_TIMEOUT_MS=10000
MAX_TOOL_ROUNDS=6
MAX_TOOL_RESULT_CHARS=40000

# Neural semantic memory (already local after the encoder is cached)
NEURAL_MEMORY_ENABLED=true
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
NEURAL_SYNC_LIMIT=256
NEURAL_MIN_SIMILARITY=0.20
NEURAL_DUPLICATE_SIMILARITY=0.88
NEURAL_SEMANTIC_WEIGHT=0.78
NEURAL_IMPORTANCE_WEIGHT=0.17
NEURAL_RECENCY_WEIGHT=0.05
NEURAL_RECENCY_HALF_LIFE_DAYS=180

# Episodic neural experience memory
EXPERIENCE_MEMORY_ENABLED=true
EXPERIENCE_AUTO_STORE=true
EXPERIENCE_RESULTS=5
EXPERIENCE_MIN_SIMILARITY=0.18
EXPERIENCE_RECENCY_HALF_LIFE_DAYS=90

HTTP_ALLOWLIST=
# false blocks private/loopback/link-local/reserved IP targets even when a hostname is allow-listed.
HTTP_ALLOW_PRIVATE_NETWORKS=false
SEARXNG_URL=

# Vision/STT/TTS are optional specialist HTTP endpoints. In embedded GGUF mode configure these explicitly.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

ENABLE_PC_TOOLS=false
PC_COMMAND_ALLOWLIST=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=

# ==========================
# TRAINABLE EXPERIENCE NETWORK (v2.5)
# ==========================
# Learns a small neural success/risk prior from explicit +/- feedback.
EXPERIENCE_POLICY_ENABLED=true
EXPERIENCE_POLICY_DIR=data/experience_policy
EXPERIENCE_POLICY_HIDDEN=64
EXPERIENCE_POLICY_DROPOUT=0.10
EXPERIENCE_POLICY_LR=0.002
EXPERIENCE_POLICY_EPOCHS=20
EXPERIENCE_POLICY_MIN_SAMPLES=4
EXPERIENCE_POLICY_MAX_SAMPLES=2000
EXPERIENCE_POLICY_USE_GPU=false

# ==========================
# CONTINUAL LoRA LEARNING (optional)
# ==========================
# Off by default because training consumes significant RAM/VRAM and should only use
# explicitly rated experiences. Enable when you have the original HF model.
CONTINUAL_LEARNING_ENABLED=false
# Local folder or Hugging Face repo for the ORIGINAL, trainable base model.
# GGUF is for inference; do not point this at model.gguf.
LORA_BASE_MODEL=
LORA_OUTPUT_DIR=data/adapters
LORA_MIN_EXAMPLES=8
LORA_MIN_REWARD=0.65
LORA_MAX_EXAMPLES=1000
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=all-linear
LORA_EPOCHS=1.0
LORA_LEARNING_RATE=0.0002
LORA_BATCH_SIZE=1
LORA_GRADIENT_ACCUMULATION=8
LORA_MAX_SEQ_LENGTH=2048
LORA_GRADIENT_CHECKPOINTING=true
LORA_LOCAL_FILES_ONLY=false

# Optional direct HF+PEFT inference. This is the backend that can apply a trained
# PEFT adapter directly without converting it to GGUF.
# MODEL_BACKEND=transformers_peft
HF_MODEL_PATH=
HF_ADAPTER_PATH=
HF_MAX_NEW_TOKENS=768
HF_LOCAL_FILES_ONLY=false
LORA_VALIDATION_FRACTION=0.15
LORA_MIN_VALIDATION_EXAMPLES=2
LORA_MAX_EVAL_REGRESSION=1.05
LORA_FILTER_SENSITIVE=true
LORA_AUTO_TRAIN_EVERY=0
HF_ADAPTER_USER=
