# ==========================
# MAIN MODEL
# ==========================
# Default: LM Studio / any OpenAI-compatible local server.
MODEL_BACKEND=openai_compatible
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_API_KEY=lm-studio
# auto = discover the first model exposed by GET /v1/models.
AI_MODEL=auto
AI_TEMPERATURE=0.35
AI_TIMEOUT_SECONDS=300

# Optional embedded GGUF mode. Only used when MODEL_BACKEND=embedded_gguf.
LOCAL_MODEL_PATH=models/model.gguf
LOCAL_MODEL_NAME=local-gguf
LOCAL_MODEL_CONTEXT=8192
LOCAL_MODEL_GPU_LAYERS=0
LOCAL_MODEL_THREADS=0
LOCAL_MODEL_CHAT_FORMAT=
LOCAL_MODEL_VERBOSE=false
LOCAL_LORA_PATH=
LOCAL_LORA_SCALE=1.0

APP_HOST=0.0.0.0
APP_PORT=8000
API_TOKEN=
DATABASE_PATH=data/agent.db
UPLOADS_DIR=data/uploads
AUTO_MEMORY=true
ENABLE_TOOLS=true
ENABLE_PLUGINS=true

MAX_CONTEXT_MESSAGES=20
MEMORY_RESULTS=8
RAG_RESULTS=6
MAX_UPLOAD_MB=20
SQLITE_BUSY_TIMEOUT_MS=10000
MAX_TOOL_ROUNDS=6
MAX_TOOL_RESULT_CHARS=40000

# Neural semantic memory
NEURAL_MEMORY_ENABLED=true
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
NEURAL_SYNC_LIMIT=256
NEURAL_MIN_SIMILARITY=0.20
NEURAL_DUPLICATE_SIMILARITY=0.88
NEURAL_SEMANTIC_WEIGHT=0.78
NEURAL_IMPORTANCE_WEIGHT=0.17
NEURAL_RECENCY_WEIGHT=0.05
NEURAL_RECENCY_HALF_LIFE_DAYS=180

# Episodic neural experience memory
EXPERIENCE_MEMORY_ENABLED=true
EXPERIENCE_AUTO_STORE=true
EXPERIENCE_RESULTS=5
EXPERIENCE_MIN_SIMILARITY=0.18
EXPERIENCE_RECENCY_HALF_LIFE_DAYS=90

# ==========================
# HUMAN-LIKE LEARNING (v2.6+)
# ==========================
HUMAN_LIKE_LEARNING_ENABLED=true
HUMAN_LEARNING_RESULTS=6
HUMAN_CONSOLIDATION_SIMILARITY=0.84
HUMAN_RETRIEVAL_MIN_SIMILARITY=0.18
HUMAN_POSITIVE_REWARD_THRESHOLD=0.35
HUMAN_NEGATIVE_REWARD_THRESHOLD=-0.35
HUMAN_REINFORCEMENT_RATE=0.35
HUMAN_RETRIEVAL_REINFORCEMENT=0.03
HUMAN_MAX_MEMORY_STRENGTH=8.0
HUMAN_FORGETTING_HALF_LIFE_DAYS=45
HUMAN_NOVELTY_THRESHOLD=0.72
HUMAN_LOW_CONFIDENCE_THRESHOLD=0.38
HUMAN_REFLECTION_ENABLED=true

# ==========================
# DEVELOPMENTAL LEARNING (v2.7+)
# ==========================
DEVELOPMENTAL_LEARNING_ENABLED=true
DEVELOPMENTAL_AUTO_GOALS=true
DEVELOPMENTAL_MAX_OPEN_GOALS=12
DEVELOPMENTAL_GOAL_CURIOSITY_THRESHOLD=0.70
DEVELOPMENTAL_GOAL_MASTERY_SUCCESSES=4
DEVELOPMENTAL_CURIOSITY_NOVELTY_WEIGHT=0.50
DEVELOPMENTAL_CURIOSITY_UNCERTAINTY_WEIGHT=0.35
DEVELOPMENTAL_CURIOSITY_GAP_WEIGHT=0.15
DEVELOPMENTAL_FEEDBACK_XP=2.0
DEVELOPMENTAL_FAILURE_LEARNING_XP=0.35
DEVELOPMENTAL_PRACTICE_XP=1.5
DEVELOPMENTAL_PRACTICE_SUCCESS_SCORE=0.72
DEVELOPMENTAL_AUTO_ANALOGIES=true
DEVELOPMENTAL_ANALOGY_CURIOSITY_THRESHOLD=0.78
DEVELOPMENTAL_AUTO_PRACTICE=false
DEVELOPMENTAL_SANDBOX_EXECUTION_ENABLED=false
DEVELOPMENTAL_SANDBOX_TIMEOUT_SECONDS=4
DEVELOPMENTAL_SANDBOX_MEMORY_MB=256
DEVELOPMENTAL_SANDBOX_MAX_OUTPUT_CHARS=12000
DEVELOPMENTAL_SANDBOX_MAX_CODE_CHARS=12000

HTTP_ALLOWLIST=
HTTP_ALLOW_PRIVATE_NETWORKS=false
SEARXNG_URL=

VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

ENABLE_PC_TOOLS=false
PC_COMMAND_ALLOWLIST=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=

# ==========================
# TRAINABLE EXPERIENCE NETWORK
# ==========================
EXPERIENCE_POLICY_ENABLED=true
EXPERIENCE_POLICY_DIR=data/experience_policy
EXPERIENCE_POLICY_HIDDEN=64
EXPERIENCE_POLICY_DROPOUT=0.10
EXPERIENCE_POLICY_LR=0.002
EXPERIENCE_POLICY_EPOCHS=20
EXPERIENCE_POLICY_MIN_SAMPLES=4
EXPERIENCE_POLICY_MAX_SAMPLES=2000
EXPERIENCE_POLICY_USE_GPU=false

# ==========================
# CONTINUAL LoRA LEARNING (optional, real weight training)
# ==========================
# LM Studio normally serves an inference model/GGUF. Real LoRA training uses the
# ORIGINAL Hugging Face base model, not the GGUF itself.
CONTINUAL_LEARNING_ENABLED=false
LORA_BASE_MODEL=
LORA_OUTPUT_DIR=data/adapters
LORA_MIN_EXAMPLES=8
LORA_MIN_REWARD=0.65
LORA_MAX_EXAMPLES=1000
LORA_RANK=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=all-linear
LORA_EPOCHS=1.0
LORA_LEARNING_RATE=0.0002
LORA_BATCH_SIZE=1
LORA_GRADIENT_ACCUMULATION=8
LORA_MAX_SEQ_LENGTH=2048
LORA_GRADIENT_CHECKPOINTING=true
LORA_LOCAL_FILES_ONLY=false

HF_MODEL_PATH=
HF_ADAPTER_PATH=
HF_MAX_NEW_TOKENS=768
HF_LOCAL_FILES_ONLY=false
LORA_VALIDATION_FRACTION=0.15
LORA_MIN_VALIDATION_EXAMPLES=2
LORA_MAX_EVAL_REGRESSION=1.05
LORA_FILTER_SENSITIVE=true
LORA_AUTO_TRAIN_EVERY=0
HF_ADAPTER_USER=
